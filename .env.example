# Copy to .env. Never commit .env.

# The NextQuest server this agent talks to (its PUBLIC_URL, without /mcp).
QUEST_SERVER_URL=https://your-tunnel.example.com

# Meta Model API key (dev.meta.ai). Needed from day 2 on.
META_API_KEY=

# A tracked quest counts as stalled when its step hasn't moved for this many days.
STALL_DAYS=3

# Where the agent keeps its OAuth tokens (created by `irysquest login`).
IRYSQUEST_HOME=.irysquest
