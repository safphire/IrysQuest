# Copy to .env. Never commit .env.

# The NextQuest server this agent talks to (its PUBLIC_URL, without /mcp).
QUEST_SERVER_URL=https://your-server.example.com

# Meta Model API key (dev.meta.ai). Used for Muse Spark and Muse Voice Transcribe.
META_API_KEY=

# A tracked quest counts as stalled when nothing about it has changed for this many days.
STALL_DAYS=3

# Where the agent keeps its tokens and its own memory (context.json).
IRYSQUEST_HOME=.irysquest

# ---- open-weight mode (optional): the same loop on Muse Spark Open ----
# MUSE_PROVIDER=meta|open. With "open", chat goes to OPEN_BASE_URL (OpenAI-compatible) and
# transcription stays on the Model API.
MUSE_PROVIDER=meta
OPEN_BASE_URL=
OPEN_MODEL=meta-models/muse-spark-open-1026
OPEN_API_KEY=

# ---- irysquest serve: the capture page and the morning schedule ----
SERVE_HOST=0.0.0.0
SERVE_PORT=8787
DIG_AT=08:00
# If set, visitors must open the page as /?try=<token>; they get previews only, nothing is proposed.
TRY_IT_TOKEN=
